# Timer policy: Persistent=true and [Install] WantedBy=timers.target are
# inherited from systemd/policy/10-base-timer.conf. `systemctl cat` shows them.
[Unit]
Description=Ping the off-box dead man's switch hourly

[Timer]
# HOURLY, and the interval is a CONTRACT WITH THE OTHER SIDE. Nothing can check
# that the two agree, which is the one weak joint in this design — so the joint is
# made as narrow as it can be: healthchecks.io accepts a systemd OnCalendar
# expression directly, and it is configured with THE LITERAL STRING BELOW rather
# than with a period translated out of it. Copy the line, do not paraphrase it.
#
#   here                    OnCalendar=*-*-* *:00:00
#   healthchecks.io         OnCalendar tab, same expression, timezone UTC
#                           Grace Time 2 hours
#
# Written out rather than as the alias `hourly`, which systemd normalizes to
# exactly this (verified: `systemd-analyze calendar hourly`). The alias would be
# one more thing the far side has to agree about how to expand.
#
# Grace on their side is 2h, so the alarm fires after roughly three hours of
# silence — two missed runs. Shortening this timer without shortening their grace
# makes the alarm take longer to be true than it looks; lengthening it without
# lengthening their grace produces false alarms. Timezone is irrelevant while the
# expression is on-the-hour, and UTC is set on their side so it stays irrelevant.
OnCalendar=*-*-* *:00:00

# Fifteen minutes, matching containers.timer and for the same reason: catallenya.service
# brings the stack up at boot and ntfy needs a moment to answer. An earlier first
# run would find ntfy not yet up, correctly refuse to ping, and exit 1 — a true
# statement that is not yet useful.
#
# This also matters after an outage: if the box was dark, healthchecks.io has
# already alarmed, and this run is what clears it. Fifteen minutes is well inside
# the 2h grace, so nothing is lost by waiting for a stack that actually works.
OnBootSec=15min

# NO RandomizedDelaySec, and this is the ONE timer in the repo that must not have
# one. Every other job here jitters so it does not fire on the hour alongside
# logrotate, man-db, the sysstat collector, disk.timer and containers.timer — a
# real concern for a job that reads every drive or walks 26 containers, and no
# concern at all for a single HTTPS GET.
#
# What jitter costs HERE is the signal. The far side is watching the clock against
# the identical expression above, so a ping arriving at :03 is a ping that was
# three minutes LATE, and healthchecks.io shows the check amber for those three
# minutes before it lands. It never alerts — that needs the full 2h grace — but it
# would mean the dashboard is amber for part of every single hour, forever. A
# status that is amber when nothing is wrong is a status you stop reading, which is
# the same argument smart.sh makes for ignoring Command_Timeout and containers.sh
# makes for re-probing watchtower's recreate window.
#
# Firing on the exact second the other side expects is what keeps green meaningful.
