[Unit]
Description=Nightly ebooks sweep (07:50 SGT)

[Timer]
# Morning-side, deliberately: everything the sweep does ends in a phone notification, and a
# 3am ping trains the owner to mute the topic. 07:50 SGT — five minutes after pigeonhole's
# sweep so the two ping bursts stay distinguishable. Timezone pinned rather than inherited:
# this host runs PDT.
OnCalendar=*-*-* 07:50:00 Asia/Singapore
RandomizedDelaySec=5min
