[Unit]
Description=Watch for ebooks approval markers
After=zfs-mount.service
Requires=zfs-mount.service

[Path]
# Fires the instant the ebooks-approve container records a button tap. The container
# writes .part-<id> and renames to <id>.json, and this glob deliberately matches only the
# finished name — a partially written marker is invisible here, so apply never reads half
# a file.
PathExistsGlob=/zpool/catallenya/ebooks/intake-state/approvals/*.json

# systemd re-checks after the service exits and re-triggers while the glob still matches.
# ebooks.apply.sh therefore deletes every marker it picks up BEFORE acting on it.

[Install]
WantedBy=paths.target
