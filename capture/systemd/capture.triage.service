[Unit]
Description=Capture triage (screenshot -> opus-5 -> proposed calendar event)
After=network-online.target docker.service
Wants=network-online.target
# Same alerting the restic units use. The triage exits non-zero only when a run
# produced no successful triage at all, or when systemd's start limit trips after
# a hot loop — both cases where the pipeline is down and nothing else would say so.
# Per-capture failures are reported over ntfy by the script itself.
OnFailure=system-ntfy@capture.triage.service

[Service]
Type=oneshot
User=carrein
Group=carrein
WorkingDirectory=/zpool/catallenya/capture
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# ANTHROPIC_API_KEY lives here — root-owned 0600, read by systemd (PID 1) and
# injected into this User=carrein process. The key is therefore never in a
# carrein-readable file, never in the repo, and never on a command line.
#
# The file is /etc/ai.env, not /etc/capture.env: documents.intake.service reads the
# same key via the shared ai/scripts/ai.lib.sh. No `-` prefix, so a missing file
# fails this unit loudly rather than running a triage that cannot possibly work.
EnvironmentFile=/etc/ai.env

# Generous: one opus-5 vision call at medium effort runs ~10-20s, and a burst of
# captures is drained serially in a single invocation.
TimeoutStartSec=15min

ExecStart=/zpool/catallenya/capture/scripts/capture.triage.sh

StandardOutput=journal
StandardError=journal

# --- Hardening ---
# The triage sends ONE plain /v1/messages request with output_config.format and
# no tools, so the model has no tool surface and no path to the filesystem. This
# sandbox is insurance against a future edit that adds tool use, and it also
# bounds the blast radius of the API key sitting in this unit's environment:
# even with the key, the process cannot read restic.pwd (InaccessiblePaths) and
# cannot WRITE anywhere outside the capture spool (ReadWritePaths).
#
# It can still READ /zpool/catallenya/.env — ProtectSystem=strict makes the tree
# read-only, not inaccessible, and .env is owned by the same user this runs as.
# What changed is that the script no longer loads it wholesale: _load_env extracts
# the four keys it needs instead of sourcing forty secrets into the process. An
# earlier version of this comment claimed the sandbox prevented the read. It does
# not, and never did.
#
# Verify the sandbox actually ENGAGED (not merely that the job succeeded):
#   sudo systemd-run --wait --pipe --uid=carrein \
#     --property=ProtectSystem=strict --property=ProtectHome=read-only \
#     --property=InaccessiblePaths=/zpool/catallenya/restic \
#     /bin/sh -c 'test -r /zpool/catallenya/restic/restic.pwd && echo FAIL || echo OK'
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# Only the spool is writable. Scripts + .env are read-only by virtue of
# ProtectSystem=strict (the repo is outside the writable set).
ReadWritePaths=/zpool/catallenya/capture/data

InaccessiblePaths=/zpool/catallenya/restic
InaccessiblePaths=/zpool/catallenya/cloudflared
InaccessiblePaths=/zpool/catallenya/rclone
