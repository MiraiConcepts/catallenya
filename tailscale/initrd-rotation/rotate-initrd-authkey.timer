[Unit]
Description=Monthly rotation of signed initramfs auth key (60-day cadence is well inside the 90-day Tailscale auth-key cap)

[Timer]
# Fire at ~04:00 local on the 1st of each month, plus up to 6h random delay
# so we don't collide with other midnight-ish timers. With a 90-day key
# lifetime, monthly rotation gives ~60 days of headroom for any individual
# rotation failure to be noticed and recovered.
OnCalendar=*-*-01 04:00:00
RandomizedDelaySec=6h
Persistent=true

[Install]
WantedBy=timers.target
