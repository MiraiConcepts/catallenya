# Class: scheduled  (see systemd/policy/20-scheduled.conf)
# Family: restic    (see systemd/policy/30-restic.conf)
# Base:             (see systemd/policy/10-base.conf)
#
# NAMING TRAP: despite being called "check", this is NOT the monitor class. A
# monitor only looks and reports and is bounded at ten minutes; check@data holds an
# EXCLUSIVE repository lock for roughly 8h30m. Classified as a monitor, systemd
# would kill the yearly integrity pass a few minutes in, every year, and the only
# symptom would be a failure notification nobody connects to the cause.
#
# MaxAge and Freshness are per-INSTANCE and live in the instance drop-ins beside
# this file (restic/check/instance-{subset,data}.conf), because the two instances
# run a month and a year apart. A template cannot express that: systemd ignores the
# [X-Catallenya] section entirely, so %i is never expanded inside it.

[Unit]
Description=Restic Check %i
OnSuccess=system-ntfy@restic.check@%i.service

[Service]
User=carrein

# Was `infinity`. Sized for the larger instance: the 2026-05-01 full read-data run
# took 8h34m, matching the documented ~8h30m. Twelve hours leaves headroom for a
# slower B2 without letting a genuinely hung run continue indefinitely while
# holding the exclusive lock that blocks every nightly backup.
#
# The subset instance finishes far sooner and is unaffected by the larger bound.
TimeoutStartSec=12h

ExecStart=/zpool/catallenya/restic/check/restic.check.sh %i

[X-Catallenya]
Class=scheduled
Family=restic
