# Class: scheduled  (see systemd/policy/20-scheduled.conf)
# Family: restic    (see systemd/policy/30-restic.conf)
# Base:             (see systemd/policy/10-base.conf)
#
# NAMING TRAP: despite being called "check", this is NOT the monitor class. A
# monitor only looks and reports and is bounded at ten minutes; check@subset holds
# an EXCLUSIVE repository lock for roughly 1h25m. Classified as a monitor, systemd
# would kill the monthly integrity pass ten minutes in, every month, and the only
# symptom would be a failure notification nobody connects to the cause.
#
# MaxAge and Freshness are per-INSTANCE and live in the instance drop-in beside
# this file (restic/check/instance-subset.conf). A template cannot express them:
# systemd ignores the [X-Catallenya] section entirely, so %i is never expanded
# inside it. check@data carries no sticker ON PURPOSE — it is manual-only since
# 2026-08-22, and an on-demand job has no cadence to be stale against.

[Unit]
Description=Restic Check %i
OnSuccess=system-ntfy@restic.check@%i.service

[Service]
User=carrein

# Was `infinity`. Still sized for the MANUAL data instance rather than the
# scheduled one: the 2026-05-01 full read-data run took 8h34m, matching the
# documented ~8h30m, and `systemctl start restic.check@data` has to be able to
# finish. Twelve hours leaves headroom for a slower B2 without letting a genuinely
# hung run continue indefinitely while holding the exclusive lock that blocks every
# nightly backup.
#
# The scheduled subset instance needs ~1h25m and is unaffected by the larger bound.
# Do NOT shrink this to fit the subset: that would silently cap the manual full read
# at a figure it is already known to exceed.
TimeoutStartSec=12h

ExecStart=/zpool/catallenya/restic/check/restic.check.sh %i

[X-Catallenya]
Class=scheduled
Family=restic
