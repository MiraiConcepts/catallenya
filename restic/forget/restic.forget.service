[Unit]
Description=Restic Forget
Requires=network-online.target
After=network-online.target
OnSuccess=system-ntfy@restic.forget.service
OnFailure=system-ntfy@restic.forget.service

[Service]
Type=oneshot
User=carrein
Group=carrein
Environment="RCLONE_CONFIG=/zpool/catallenya/rclone/.rclone.conf"
ExecStart=/zpool/catallenya/restic/forget/restic.forget.sh
StandardOutput=journal
StandardError=journal