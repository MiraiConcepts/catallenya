# Class: scheduled  (see systemd/policy/20-scheduled.conf)
# Family: restic    (see systemd/policy/30-restic.conf)
# Base:             (see systemd/policy/10-base.conf)

[Unit]
Description=Restic Forget
OnSuccess=system-ntfy@restic.forget.service

[Service]
User=carrein

# Was `infinity`. prune holds an exclusive repository lock, so a hung run blocks
# every backup behind it — and because restic refreshes its own lock every five
# minutes, a stuck run is never collected as stale. The timeout is the only exit.
#
# Runs take 2-3 minutes normally; the 2026-08-10 run took 6 after 0.19.0 started
# repacking small packfiles far more aggressively. Two hours is generous for a
# repeat of that and still finite.
TimeoutStartSec=2h

ExecStart=/zpool/catallenya/restic/forget/restic.forget.sh

[X-Catallenya]
Class=scheduled
Family=restic
# Weekly, Monday 06:00 with an hour of jitter. 9d allows one missed week.
MaxAge=9d
# No artifact. "Snapshots were forgotten" leaves nothing observable — the repo
# looks the same whether the policy ran or the policy had nothing to do.
Freshness=stamp:/zpool/catallenya/systemd/state/restic.forget
