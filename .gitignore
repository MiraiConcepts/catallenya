# Ignore everything by default
*

# Except these root files
!README.md
!CLAUDE.md
!.gitignore
!docker-compose.yml
!archivebox.Dockerfile
!catallenya.png

# Except these folders (include everything inside)
!audit/
!caddy/
!cloudflared/
!rclone/
!ntfy/
!restic/
!sanoid/
!systemd/
!zpool/
!.github/
!immich/
!tailscale/

# Explicit exclude audit logs
!audit/audit.sh

# Explicit includes inside restic folder
!restic/backup/
!restic/backup/**
!restic/check/
!restic/check/**
!restic/forget/
!restic/forget/**
!restic/misc/
!restic/misc/restic.restore.sh
!restic/misc/restic.snapshots.sh
!restic/misc/restic.unlock.sh
!restic/misc/restic.locks.sh
!restic/restic.conf

# Explicit includes inside .github workflows
!.github/workflows/
!.github/workflows/**``

# Explicit includes inside caddy and cloudflared subfolders
!caddy/Caddyfile
!cloudflared/cloudflared.md

# Immich Public Proxy config (non-secret, stack-defining; mirrors caddy/Caddyfile).
# The container bind-mounts this file read-only, so it must exist on disk before
# `up` — track it so the service is reproducible from the repo.
!immich-public-proxy/
!immich-public-proxy/config.json

# Explicit includes notification scripts
!ntfy/**
!ntfy/.env

# Explicit includes systemd services
!systemd/**

# Explicit includes inside tailscale folder
# (tailscale/data + tailscale/tmp hold runtime state and stay ignored by the default `*` deny)
!tailscale/initrd-identity/
!tailscale/initrd-identity/**
!tailscale/initramfs-hooks/
!tailscale/initramfs-hooks/**

# Explicit includes inside immich folder
# (raw photo data + .immich_api_key stay ignored by the default `*` deny)
!immich/scripts/
!immich/scripts/immich.conf
!immich/scripts/immich.lib.sh
!immich/scripts/immich.validate.sh
!immich/scripts/immich.find-junk.sh
!immich/scripts/immich.verify-junk.sh
!immich/scripts/immich.delete.sh
!immich/scripts/immich.restore.sh
!immich/scripts/immich.fix-dates.scan.sh
!immich/scripts/immich.fix-dates.verify.sh
!immich/scripts/immich.fix-dates.apply.sh
!immich/scripts/README.md