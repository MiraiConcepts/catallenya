#!/usr/bin/env bash
# Runs the CI shell check BEFORE the push instead of after it. Convenience only
# — CI remains the authority, and removing it would be a mistake: a hook can be
# bypassed with --no-verify, is absent on a fresh clone until installed, never
# sees a dependabot PR, and cannot gate the mirror publish the way CI's
# `needs:` does. This saves the round trip; it does not replace the gate.
#
# pre-PUSH rather than pre-commit, deliberately. audit/pre-commit guards secrets,
# which are irreversible the moment they are pushed to a public repo that force-
# pushes to every mirror — those must be stopped at commit time. A shell fault
# is reversible and costs only a red build, so it is checked once per push
# rather than on every commit. A check that fires on every docs typo is a check
# people learn to skip with --no-verify, which would cost the secret guard its
# credibility too, since that is the same flag.
#
# The tracked master is this file; install it with audit/install-hooks.sh, and
# audit.sh section 17 reports it missing, non-executable or drifted.
set -euo pipefail

# git passes the remote name and URL as $1/$2 and the refs on stdin. None of it
# changes what is checked: the scope is every tracked *.sh, same as CI.
ROOT="$(git rev-parse --show-toplevel)"

# The secret scan runs FIRST, and it is the cheapest thing here — 0.3s for the
# full history, against 1.7s for the contract gate and 5.9s for the shell sweep.
# Cheapest-first is not the reason it leads, though: it is the only check whose
# failure is IRREVERSIBLE once the push lands. This repo is public and force-
# pushes to six public mirrors, so a leaked credential is disclosed the moment
# the push completes; a shell fault or a refused unit costs a red build. Owner's
# call, 2026-08-25 — the same file CI runs, so a bypassed hook is still caught by
# CI over the full history, and neither side can drift from the other.
#
# It is deliberately the SAME invocation, not a cheaper staged-only variant. At
# pre-push time the commits already exist, so `detect` over history asks exactly
# the question CI asks, and parity is literal rather than approximate.
"${ROOT}/ci/gitleaks.sh"

# The contract gate then runs before shellcheck because it is the faster
# of them (1.7s against 5.9s), so a unit violation fails in under two seconds
# rather than after the whole shell sweep.
#
# It was added 2026-08-23 after a unit the gate refuses reached main green: the
# hook ran shellcheck, CI ran shellcheck, and NOTHING anywhere looked at unit
# files. Both mirrored checks are in the same class — a shell fault and a contract
# violation are both invisible until the day something runs them, which is what
# earns a check a place in the per-push path. A compose typo is not: it announces
# itself the moment you `docker compose up`, which is why compose-validate stays
# CI-only.
"${ROOT}/ci/contract.sh"
"${ROOT}/ci/shellcheck.sh"

# FOUR checks now, cheapest first, and the last changes what this hook is.
#
# The first three are mirrored in CI and cost 7.9s between them. This one is the full
# test suite — 1,124 cases, ~132s — and it is HOOK-ONLY because it provably cannot
# run anywhere else: every suite resolves /zpool/catallenya absolutely and on
# purpose, so on a runner six of the seven fail in bulk and the seventh cannot
# start. See ci/tests.sh.
#
# A push therefore takes a little over two minutes, chosen with that number in hand
# (owner, 2026-08-23). It sits against the warning at the top of this file, which
# still stands: if two minutes on a docs commit ever starts producing --no-verify,
# SCOPE this to the suites whose directories changed — measured at ~8s for a docs
# push — rather than deleting it, and do that before reaching for the flag once.
# The flag is the same one that disarms the secret guard.
exec "${ROOT}/ci/tests.sh"
