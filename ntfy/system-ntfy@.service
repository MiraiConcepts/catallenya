[Unit]
Description=Ntfy Alert for %i
Requires=network-online.target
After=network-online.target

# THE RATE LIMIT IS OFF, AND THAT IS THE POINT.
#
# Note the section: StartLimitIntervalSec= and StartLimitBurst= live in [Unit], the
# same trap 20-adhoc.conf calls out. Putting them under [Service] is silently ignored.
#
# Until 2026-08-24 this unit inherited systemd's defaults — 5 starts per 10 seconds —
# because the comment below correctly says every class bound must be written out here
# and then wrote only the timeout. The result was a courier that DESTROYS alerts
# exactly when they matter most, since faults arrive in bursts and a burst is what
# trips a rate limit. It is not theoretical: on 2026-08-14 liquidroom.triage failed
# 203/EXEC thirteen times in about a second under its .path unit, five alerts went
# out and SEVEN were destroyed with `start-limit-hit` — and systemd reports a failed
# OnFailure= handler nowhere, so nothing said so. Seven such events in 30 days.
#
# Disabling rather than raising, because a bound here is redundant as a safety
# mechanism and harmful as a rate limit. The courier cannot start more often than
# something asks it to, and every asker is already bounded: adhoc jobs at 12 per
# 30 minutes (20-adhoc.conf), and timer-driven jobs by their own schedule. So a
# limit here can never prevent a runaway that the upstream limit would not already
# have stopped — it can only drop alerts the upstream deliberately allowed.
#
# An alert that never arrives is worse than a duplicate. The duplicate is at worst
# noise; the missing one is indistinguishable from health, which is the failure this
# whole fleet is built to avoid.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=carrein
Group=carrein
ExecStart=/zpool/catallenya/ntfy/system-ntfy.sh %i

# Declared HERE, not inherited, because this unit is PLUMBING: install.sh links no
# policy drop-in onto it at all. Giving the courier the base policy would wire its
# own OnFailure= back to itself, so a failed alert would start a courier to complain
# about the courier, which fails, which starts another. The price of that exemption
# is that every bound the classes provide has to be written out here — and this is
# the one that was missing.
#
# Without it the unit ran at the Type=oneshot default of `infinity`. An ntfy that
# accepts the connection and never answers would leave a failure handler hanging
# forever, holding a job in `activating` for the job it was reporting on — and
# nothing watches the courier, by design. The script's own curl --max-time 15 is the
# inner bound; this is the outer one, sized so it can only ever be reached by
# something the curl timeout did not cover (DNS, a wedged TLS handshake).
#
# RuntimeMaxSec= would be the wrong directive: systemd IGNORES it on Type=oneshot
# while still reporting it in `systemctl show`.
TimeoutStartSec=2min
