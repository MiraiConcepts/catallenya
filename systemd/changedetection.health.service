[Unit]
Description=Changedetection Watch Health Check
Requires=docker.service
After=docker.service network-online.target
# Backstop only. changedetection-ntfy.sh posts its own findings to the changedetection
# topic — a broken watch, a stalled worker, a container that is not running. This covers
# the case the script cannot report itself: dying before it gets that far (missing .env,
# docker unreachable, syntax error). A monitor that cannot report its own death would
# reintroduce the exact silent-failure problem this unit exists to close.
OnFailure=system-ntfy@changedetection.health.service

[Service]
Type=oneshot
User=carrein
Group=carrein
NoNewPrivileges=true
PrivateTmp=true
ExecStart=/zpool/catallenya/ntfy/changedetection-ntfy.sh
StandardOutput=journal
StandardError=journal
