[Unit]
Description=Nightly documents intake (classify + file master/documents)
After=network-online.target

[Service]
Type=oneshot
User=carrein
Group=carrein
WorkingDirectory=/zpool/catallenya/syncthing/intake-state
Environment=HOME=/home/carrein
Environment=PATH=/home/carrein/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=DISABLE_AUTOUPDATER=1
EnvironmentFile=-/etc/documents-intake.env
TimeoutStartSec=30min

# NO ExecStartPre auth check — deliberately. Two proven facts (2026-07-18):
#   1. `claude auth status` exits 0 even with a bogus token — it validates nothing.
#   2. An ExecStartPre failure kills the unit BEFORE daily.sh starts, so the ntfy code
#      never runs and auth death would be silent.
# The real detector is the API call inside classify: on dead auth, daily.sh sends a
# HIGH-priority ntfy ("failed (classify) — check auth first") the first night a document
# is actually waiting, and the file stays at root (7-day nudge as backup). Empty nights
# with dead auth stay silent — nothing was lost, nothing to file.
ExecStart=/zpool/catallenya/syncthing/scripts/documents.intake.daily.sh --yes

StandardOutput=journal
StandardError=journal

# --- Hardening ---
# NOT protection against today's design: the classifier already has no filesystem access
# (--tools "StructuredOutput" is its only tool, and it is the answer channel). This is
# insurance against a FUTURE edit that drops --tools or --setting-sources and hands the
# model real tools back. These directives are what stop a regression reaching restic.pwd
# or .env.
#
# Verify with:
#   sudo systemd-run --wait --pipe --uid=carrein \
#     --property=ProtectSystem=strict --property=ProtectHome=read-only \
#     --property=InaccessiblePaths=/zpool/catallenya/restic \
#     /bin/sh -c 'test -r /zpool/catallenya/restic/restic.pwd && echo FAIL || echo OK'
# Assert the sandbox ENGAGED, not that the job succeeded: `systemd-run --user` silently
# accepts these properties and discards them (kernel.apparmor_restrict_unprivileged_userns
# =1 on this host), so a user-scope test passes while protecting nothing.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/zpool/catallenya/syncthing/data/master/documents
ReadWritePaths=/zpool/catallenya/syncthing/intake-state

InaccessiblePaths=/zpool/catallenya/restic
InaccessiblePaths=/zpool/catallenya/cloudflared
InaccessiblePaths=/zpool/catallenya/rclone
