[Unit]
Description=Nightly documents intake (classify + file master/documents)
After=network-online.target

[Service]
Type=oneshot
User=carrein
Group=carrein
WorkingDirectory=/zpool/catallenya/syncthing/intake-state
Environment=HOME=/home/carrein
Environment=PATH=/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=30min

# ANTHROPIC_API_KEY lives here — root-owned 0600, read by systemd (PID 1) and injected
# into this User=carrein process, so the key is never in a carrein-readable file. The
# same file feeds capture.triage.service; both go through ai/scripts/ai.lib.sh. No `-`
# prefix, so a missing file fails this unit loudly.
EnvironmentFile=/etc/ai.env

# NO ExecStartPre auth check — deliberately, and the reasoning survived the move off
# `claude -p`. An ExecStartPre failure kills the unit BEFORE daily.sh starts, so the
# ntfy code never runs and a dead credential would be silent. (The old note also
# recorded that `claude auth status` exits 0 with a bogus token; that command is gone,
# but a cheap pre-check would have the same shape and the same flaw.)
# The real detector is the API call inside classify: api_class maps 401 to `fatal`,
# classify records CLASSIFY_FAILED, and daily.sh sends a HIGH-priority ntfy the first
# night a document is actually waiting — with the file left at root (7-day nudge as
# backup). Empty nights with a dead key stay silent: nothing was lost, nothing to file.
ExecStart=/zpool/catallenya/syncthing/scripts/documents.intake.daily.sh --yes

StandardOutput=journal
StandardError=journal

# --- Hardening ---
# NOT protection against today's design: the classifier posts one plain /v1/messages
# request with no `tools` key, so the model has no tool surface and no path to the
# filesystem. What these directives actually do now is bound the blast radius of the
# API key sitting in this unit's environment — same reasoning, same wording, as
# capture.triage.service. Even with the key, the process cannot read restic.pwd
# (InaccessiblePaths) and cannot WRITE outside the two paths below (ReadWritePaths).
#
# It can still READ /zpool/catallenya/.env — ProtectSystem=strict makes the tree
# read-only, not inaccessible, and .env is owned by the same user this runs as.
#
# Verify with:
#   sudo systemd-run --wait --pipe --uid=carrein \
#     --property=ProtectSystem=strict --property=ProtectHome=read-only \
#     --property=InaccessiblePaths=/zpool/catallenya/restic \
#     /bin/sh -c 'test -r /zpool/catallenya/restic/restic.pwd && echo FAIL || echo OK'
# Assert the sandbox ENGAGED, not that the job succeeded: `systemd-run --user` silently
# accepts these properties and discards them (kernel.apparmor_restrict_unprivileged_userns
# =1 on this host), so a user-scope test passes while protecting nothing.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/zpool/catallenya/syncthing/data/master/documents
ReadWritePaths=/zpool/catallenya/syncthing/intake-state

InaccessiblePaths=/zpool/catallenya/restic
InaccessiblePaths=/zpool/catallenya/cloudflared
InaccessiblePaths=/zpool/catallenya/rclone
