[Unit]
Description=Nightly documents intake

[Timer]
# 03:00 SGT — clear of the immich rotation bake (04:00 SGT) and restic's
# host-local-midnight backup. Timezone pinned explicitly, DST-safe.
OnCalendar=*-*-* 03:00:00 Asia/Singapore
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
