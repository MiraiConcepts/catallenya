# Class: scheduled  (see systemd/policy/20-scheduled.conf)
# Base:             (see systemd/policy/10-base.conf)
#
# Inherited and therefore NOT repeated here: OnFailure, Type, journal logging and
# the base hardening. The script prints one line per run; on failure that line is
# what the courier quotes (topic falls through to `host`, by design). A layout
# change on filmhouse.sg fails the run loudly and writes nothing.
#
# Writes ONE Radicale collection, carrein/filmhouse, through the shared feeds sink
# (feeds_sink.py) over CalDAV to radicale:5232 on the docker network. Reads one page,
# https://filmhouse.sg/films/, once a run. A showing marked "going" in hitome that
# disappears is cancelled rather than deleted, and announced on the `hitome` topic
# by feeds.notify.sh. The credential is the host-only afterimage/dav-secret.

[Unit]
Description=Sync Filmhouse showtimes (filmhouse.sg) into Radicale
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
User=carrein
Group=carrein
# One page fetch and ~250 local CalDAV requests: seconds in practice. Ten minutes
# is the hang bound.
TimeoutStartSec=10min
ExecStart=/usr/bin/python3 -I /zpool/catallenya/radicale/feeds/filmhouse.sync.py

[X-Catallenya]
Class=scheduled
# Daily. 3d allows two missed runs before the watchdog speaks.
MaxAge=3d
# No artifact of its own worth trusting: an unchanged day writes nothing.
Freshness=stamp:/zpool/catallenya/systemd/state/filmhouse.sync
