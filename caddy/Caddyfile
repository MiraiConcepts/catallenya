(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Serve one of the blog's own pages under a different status code, for the
# section toggles in the catallenya.com block. Args: page path, status.
(blog_page) {
	rewrite * {args[0]}
	reverse_proxy carrein-blog:80 {
		@ok status 200
		handle_response @ok {
			header Content-Type "text/html; charset=utf-8"
			copy_response {args[1]}
		}
	}
}

# Public traffic enters here from cloudflared (TLS terminated upstream at CF edge).
# Internal-bridge only — caddy:80 is not host-mapped. Path-split between blog and upvotes API.
http://catallenya.com {
	import security_headers

	# Lets the section toggles below strip hidden sections from the nav. The blog
	# wraps each nav link in <!--{{if not (fileExists "hide-<name>.on")}}--> ...
	# <!--{{end}}-->, which is an inert HTML comment anywhere this doesn't run.
	# Only text/html responses are buffered and parsed.
	templates {
		mime text/html
		root /flags
		between <!--{{ }}-->
	}

	@upvotes path /api/votes /api/votes/*
	handle @upvotes {
		reverse_proxy upvotes:8080
	}

	# Maintenance toggle: ON whenever /flags/maintenance.on exists (flag file is
	# bind-mounted read-only at /flags, re-checked per request - touch/rm to flip,
	# no reload needed). Page URLs get the blog's /maintenance.html as HTTP 503;
	# static assets are excluded so the page still renders. The vote API is handled
	# above and never reaches this matcher.
	@down_page {
		file {
			root /flags
			try_files maintenance.on
		}
		not path /image/* /assets/* /styles/*
	}
	handle @down_page {
		rewrite * /maintenance.html
		reverse_proxy carrein-blog:80 {
			@ok status 200
			handle_response @ok {
				header Content-Type "text/html; charset=utf-8"
				header Retry-After 3600
				copy_response 503
			}
		}
	}

	# Section toggles, same idea as maintenance: /flags/hide-<name>.on hides the
	# blog section whose URL starts with /<name> (hide-music.on -> /music/*),
	# re-checked per request, no reload. Hidden URLs get the blog's /404.html as a
	# 404 and the templates block above drops the nav link. Writings is the home
	# page, so hide-writings.on also covers /posts and /tagged, and "/" gets the
	# blog's /home-redirect.html: a 302 to the first visible section (404 if none).
	# /index.html is the same page under its file name, so it is matched with "/".
	# Sections and their order live in the blog repo's site.config.js; adding one
	# needs no change here.
	@home_hidden {
		path / /index.html
		file {
			root /flags
			try_files hide-writings.on
		}
	}
	handle @home_hidden {
		import blog_page /home-redirect.html 302
	}

	@writings_hidden {
		path /posts /posts/* /tagged /tagged/*
		file {
			root /flags
			try_files hide-writings.on
		}
	}
	handle @writings_hidden {
		import blog_page /404.html 404
	}

	# The section name comes from path_regexp, never {path.0}. {path.0} is split
	# from the RAW path, so //gallery/ or /image/..%2fgallery/ looked up the wrong
	# flag and nginx then tidied the path and served the hidden section anyway.
	# path matchers clean the path before matching, so they see /gallery/.
	# The flag check is nested one level down on purpose: matchers inside one set
	# run in no fixed order, and a flat version read an empty {re.section.1} on
	# 3 of 8 starts.
	@section_path {
		not path /image/* /assets/* /styles/*
		path_regexp section ^/([^/]+)
	}
	handle @section_path {
		@section_hidden {
			file {
				root /flags
				try_files hide-{re.section.1}.on
			}
		}
		handle @section_hidden {
			import blog_page /404.html 404
		}
		handle {
			reverse_proxy carrein-blog:80
		}
	}

	handle {
		reverse_proxy carrein-blog:80
	}
}

# Public image CDN origin — IPP behind the catallenya-tunnel (TLS terminated at the CF
# edge; internal-bridge only, caddy:80 is not host-mapped). cloudflared forwards
# img.catallenya.com here. Only publicly-shared Immich albums are reachable; Immich
# itself stays private. Cloudflare Image Transformations rewrite /cdn-cgi/image/… at
# the edge against these /share/photo/… sources.
http://img.catallenya.com {
	import security_headers
	# Serve the raw original inline (display in tab) rather than the upstream's
	# Content-Disposition: attachment (download). Scoped to /original only —
	# previews, thumbnails, album HTML, and CF transforms are unaffected.
	@original path */original
	header @original {
		Content-Disposition inline
		defer
	}
	# Album HTML only (one segment after /share/, e.g. /share/<key>) — make the
	# browser revalidate instead of holding the upstream 30d max-age, while the
	# Cloudflare edge keeps short-TTL caching it. Does NOT match /share/photo/...
	# or /share/static/... (those keep their long cache). defer = replace, not add.
	@albumhtml path_regexp ^/share/[^/]+$
	header @albumhtml {
		Cache-Control "no-cache"
		defer
	}
	reverse_proxy immich-public-proxy:3000
}

