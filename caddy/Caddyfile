# Immich Public Proxy — public gallery surface for publicly-shared albums only.
# Fronts the PRIVATE immich-server; the blog reads albums here, never from Immich.
{$TAILNET_DOMAIN}.{$TAILNET_DNS_NAME}:{$IPP_REVERSE_PROXY_PORT} {
	import security_headers
	reverse_proxy immich-public-proxy:3000
}

{$TAILNET_DOMAIN}.{$TAILNET_DNS_NAME}:{$RADICALE_REVERSE_PROXY_PORT} {
	import security_headers
	reverse_proxy radicale:5232
}

{$TAILNET_DOMAIN}.{$TAILNET_DNS_NAME}:{$NTFY_REVERSE_PROXY_PORT} {
	import security_headers
	reverse_proxy ntfy:80
}

# Screenshot capture: the desktop hotkey POSTs here, and the ntfy Add/Discard
# buttons POST back here. Tailnet-only like everything else; the unguessable
# <id> in the callback paths is what gates the buttons.
{$TAILNET_DOMAIN}.{$TAILNET_DNS_NAME}:{$AFTERIMAGE_REVERSE_PROXY_PORT} {
	import security_headers
	# Screenshots are ~1-3MB; Caddy's default request body cap would reject them.
	request_body {
		max_size 16MB
	}
	reverse_proxy afterimage:8080
}

{$TAILNET_DOMAIN}.{$TAILNET_DNS_NAME}:{$PIGEONHOLE_REVERSE_PROXY_PORT} {
	import security_headers
	# Every request here is an empty POST from an ntfy button. No upload path, so
	# the default body cap is already far more than needed — deliberately NOT
	# raised, unlike the afterimage block above.
	reverse_proxy pigeonhole-approve:8080
}

{$TAILNET_DOMAIN}.{$TAILNET_DNS_NAME}:{$ARCHIVEBOX_REVERSE_PROXY_PORT} {
	import security_headers
	reverse_proxy archivebox:8000
}

{$TAILNET_DOMAIN}.{$TAILNET_DNS_NAME}:{$MEMOKA_REVERSE_PROXY_PORT} {
	import security_headers
	redir / /app/ 308

	# Web app and static files
	handle /app/* {
		reverse_proxy memoka:8082
		header Cross-Origin-Resource-Policy cross-origin
	}

	# Media files (served by web server)
	handle /media/* {
		reverse_proxy memoka:8082
		header Cross-Origin-Resource-Policy cross-origin
	}

	handle /healthcheck {
		reverse_proxy memoka:8082
	}

	# Everything else goes to API server
	handle {
		reverse_proxy memoka:8080
	}
}

{$TAILNET_DOMAIN}.{$TAILNET_DNS_NAME}:{$CHANGEDETECTION_REVERSE_PROXY_PORT} {
	import security_headers
	reverse_proxy changedetection:5000
}

{$TAILNET_DOMAIN}.{$TAILNET_DNS_NAME}:{$HITOME_REVERSE_PROXY_PORT} {
	# CalDAV, same-origin: strip /dav before proxying; X-Script-Name makes
	# Radicale emit hrefs under /dav so discovery resolves through this block.
	handle_path /dav/* {
		reverse_proxy radicale:5232 {
			header_up X-Script-Name /dav
			header_up Authorization "Basic {$HITOME_DAV_B64}"
		}
	}

	handle {
		reverse_proxy hitome:80
	}
}

{$TAILNET_DOMAIN}.{$TAILNET_DNS_NAME}:{$KARAKEEP_REVERSE_PROXY_PORT} {
	# Karakeep shows its own full-page archives and PDFs in iframes from this same
	# origin (/api/assets/*), which the snippet's X-Frame-Options DENY would refuse
	# to render. SAMEORIGIN still refuses every other site.
	#
	# Deferred and placed BEFORE the import, and both are load-bearing: the snippet's
	# `-Server` makes its whole block deferred, deferred blocks apply in reverse order,
	# so a plain override (or one after the import) is overwritten back to DENY.
	header {
		X-Frame-Options SAMEORIGIN
		defer
	}
	import security_headers
	reverse_proxy karakeep:3000
}