(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Public traffic enters here from cloudflared (TLS terminated upstream at CF edge).
# Internal-bridge only — caddy:80 is not host-mapped. Path-split between blog and upvotes API.
http://catallenya.com {
	import security_headers
	@upvotes path /api/votes /api/votes/*
	handle @upvotes {
		reverse_proxy upvotes:8080
	}
	handle {
		reverse_proxy carrein-blog:80
	}
}

{$TAILNET_DOMAIN}.{$TAILNET_DNS_NAME}:{$FLAME_REVERSE_PROXY_PORT} {
	import security_headers
	reverse_proxy flame:5005
}

{$TAILNET_DOMAIN}.{$TAILNET_DNS_NAME}:{$SYNCTHING_REVERSE_PROXY_PORT} {
	import security_headers
	reverse_proxy syncthing:8384
}

{$TAILNET_DOMAIN}.{$TAILNET_DNS_NAME}:{$IMMICH_REVERSE_PROXY_PORT} {
	import security_headers
	reverse_proxy immich-server:2283
}

{$TAILNET_DOMAIN}.{$TAILNET_DNS_NAME}:{$RADICALE_REVERSE_PROXY_PORT} {
	import security_headers
	reverse_proxy radicale:5232
}

{$TAILNET_DOMAIN}.{$TAILNET_DNS_NAME}:{$GHOST_REVERSE_PROXY_CADDY_PORT} {
	import security_headers
	reverse_proxy ghost:2368
}

{$TAILNET_DOMAIN}.{$TAILNET_DNS_NAME}:{$NTFY_REVERSE_PROXY_PORT} {
	import security_headers
	reverse_proxy ntfy:80
}

{$TAILNET_DOMAIN}.{$TAILNET_DNS_NAME}:{$ARCHIVEBOX_REVERSE_PROXY_PORT} {
	import security_headers
	reverse_proxy archivebox:8000
}

{$TAILNET_DOMAIN}.{$TAILNET_DNS_NAME}:{$MEMOKA_REVERSE_PROXY_PORT} {
	import security_headers
	redir / /app/ 308

	# Web app and static files
	handle /app/* {
		reverse_proxy memoka:8082
		header Cross-Origin-Resource-Policy cross-origin
	}

	# Media files (served by web server)
	handle /media/* {
		reverse_proxy memoka:8082
		header Cross-Origin-Resource-Policy cross-origin
	}

	handle /healthcheck {
		reverse_proxy memoka:8082
	}

	# Everything else goes to API server
	handle {
		reverse_proxy memoka:8080
	}
}