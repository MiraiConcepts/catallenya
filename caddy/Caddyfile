(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Public traffic enters here from cloudflared (TLS terminated upstream at CF edge).
# Internal-bridge only — caddy:80 is not host-mapped. Path-split between blog and upvotes API.
http://catallenya.com {
	import security_headers

	@upvotes path /api/votes /api/votes/*
	handle @upvotes {
		reverse_proxy upvotes:8080
	}

	# Maintenance toggle: ON whenever /flags/maintenance.on exists (flag file is
	# bind-mounted read-only at /flags, re-checked per request - touch/rm to flip,
	# no reload needed). Page URLs get the blog's /maintenance.html as HTTP 503;
	# static assets are excluded so the page still renders. The vote API is handled
	# above and never reaches this matcher.
	@down_page {
		file {
			root /flags
			try_files maintenance.on
		}
		not path /image/* /assets/* /styles/*
	}
	handle @down_page {
		rewrite * /maintenance.html
		reverse_proxy carrein-blog:80 {
			@ok status 200
			handle_response @ok {
				header Content-Type "text/html; charset=utf-8"
				header Retry-After 3600
				copy_response 503
			}
		}
	}

	handle {
		reverse_proxy carrein-blog:80
	}
}

# Public image CDN origin — IPP behind the catallenya-tunnel (TLS terminated at the CF
# edge; internal-bridge only, caddy:80 is not host-mapped). cloudflared forwards
# img.catallenya.com here. Only publicly-shared Immich albums are reachable; Immich
# itself stays private. Cloudflare Image Transformations rewrite /cdn-cgi/image/… at
# the edge against these /share/photo/… sources.
http://img.catallenya.com {
	import security_headers
	# Serve the raw original inline (display in tab) rather than the upstream's
	# Content-Disposition: attachment (download). Scoped to /original only —
	# previews, thumbnails, album HTML, and CF transforms are unaffected.
	@original path */original
	header @original {
		Content-Disposition inline
		defer
	}
	# Album HTML only (one segment after /share/, e.g. /share/<key>) — make the
	# browser revalidate instead of holding the upstream 30d max-age, while the
	# Cloudflare edge keeps short-TTL caching it. Does NOT match /share/photo/...
	# or /share/static/... (those keep their long cache). defer = replace, not add.
	@albumhtml path_regexp ^/share/[^/]+$
	header @albumhtml {
		Cache-Control "no-cache"
		defer
	}
	reverse_proxy immich-public-proxy:3000
}

