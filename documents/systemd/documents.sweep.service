[Unit]
Description=Documents sweep (re-notify stale proposals, bin week-old ones)
After=zfs-mount.service network-online.target
Requires=zfs-mount.service
Wants=network-online.target
OnFailure=system-ntfy@documents.sweep.service

[Service]
Type=oneshot
User=carrein
Group=carrein
WorkingDirectory=/zpool/catallenya/documents/intake-state
Environment=HOME=/home/carrein
Environment=PATH=/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=5min

# No ANTHROPIC_API_KEY here, deliberately: the sweep makes no API calls. It reads
# records the triage wrote, moves week-old staged files to bin/, and posts to ntfy
# — it has no reason to hold the key. Same split as capture.sweep.service.
ExecStart=/zpool/catallenya/documents/scripts/documents.sweep.sh

StandardOutput=journal
StandardError=journal

# --- Hardening ---
# Second writer to master/documents after documents.apply.service, held to the
# same standard: a oneshot with no network listener, unreachable from anything,
# whose only writes are staged -> bin/ moves on records the triage produced. The
# approve container still cannot perform a move at all.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

ReadWritePaths=/zpool/catallenya/syncthing/data/master/documents
ReadWritePaths=/zpool/catallenya/documents/intake-state

InaccessiblePaths=/zpool/catallenya/restic
InaccessiblePaths=/zpool/catallenya/cloudflared
InaccessiblePaths=/zpool/catallenya/rclone
